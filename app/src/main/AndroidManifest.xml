<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.lantern">

    <!-- To read ROM folders in shared storage. Granted by the person in Settings; this build is sideloaded. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Cover art fetching, which is off until the person turns it on. Nothing else uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ hides other apps unless we ask to see launchable ones. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Lantern"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowNativeHeapPointerTagging="false"
        android:theme="@style/Lantern">

        <!-- HOME makes Lantern selectable as the device's home screen. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Games run in their own process: a core that crashes must not take the home screen with it. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:process=":player"
            android:taskAffinity="app.lantern.player"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode" />
    </application>
</manifest>
