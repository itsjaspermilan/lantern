<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Everything is HTTPS, except this device talking to itself. That one exception lets art-source.txt
         point at a test server on this computer through `adb reverse`. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
